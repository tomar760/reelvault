# ===== ReelVault Backend — Environment Variables =====
# Copy this file to ".env" and fill real values (NEVER commit .env to GitHub!)

# ============================================================
# GOOGLE KEY — 4 mein se SIRF EK tareeka chuno.
# SABSE EASY = TAREEKA 1 (Render Secret File):
# ============================================================
#
# [TAREEKA 1 — SABSE EASY, recommended]
#   Render Dashboard → apni service → Environment → "Secret Files"
#   → "Add Secret File" → Filename: key.json → Contents: apni JSON paste/upload
#   → Code mein KUCH set karne ki zaroorat NAHI — apne aap /etc/secrets/key.json se padh lega
#
# [TAREEKA 2] Key file ka path do:
# GOOGLE_KEY_FILE=/etc/secrets/key.json
#
# [TAREEKA 3] Puri JSON ka content ek variable mein paste karo:
# GOOGLE_KEY_JSON={"type":"service_account","project_id":"...",...poori file...}
#
# [TAREEKA 4] Base64 string (purana tareeka):
# GOOGLE_KEY_BASE64=
#
# LOCAL testing ke liye: .env mein likho  GOOGLE_KEY_FILE=./key.json
# (aur key.json ko git mein KABHI push mat karna!)
# ============================================================

# Google Sheet ID — sheet ke URL ka beech wala part:
# docs.google.com/spreadsheets/d/<YE_WALA_PART>/edit
SHEET_ID=

# Google Drive root folder ID — "ReelVault" folder ke URL ka last part:
# drive.google.com/drive/folders/<YE_WALA_PART>
DRIVE_FOLDER_ID=

# NVIDIA NIM free API key — build.nvidia.com se (optional — khali chhoda to AI tagging skip ho jayega)
NIM_API_KEY=

# Dashboard ka secret passcode (lock screen wala — 4 digits)
APP_PASSCODE=1234

# Tumhari frontend URL — CORS sirf isi ko allow karega
FRONTEND_URL=https://YOUR-USERNAME.github.io

# Optional: Instagram/FB download block ho jaye to — browser cookies (base64)
IG_COOKIES_BASE64=

# Optional tuning
RETRY_GAP_MIN=5
PORT=3000
