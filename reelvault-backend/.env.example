# ===== ReelVault Backend — Environment Variables =====
# Copy this file to ".env" and fill real values (NEVER commit .env to GitHub!)

# Google service-account JSON, base64-encoded (Section 11.A of the SOP)
GOOGLE_KEY_BASE64=

# Google Sheet ID — from the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
SHEET_ID=

# Google Drive root folder ID — folder named "ReelVault": drive.google.com/drive/folders/<THIS_PART>
DRIVE_FOLDER_ID=

# NVIDIA NIM free API key — from build.nvidia.com (optional — tagging skipped if empty)
NIM_API_KEY=

# Dashboard secret passcode (same one you type on the lock screen)
APP_PASSCODE=1234

# Your frontend URL — CORS will only allow THIS origin
FRONTEND_URL=https://YOUR-USERNAME.github.io

# Optional: if Instagram/Facebook start blocking downloads —
# export cookies.txt from your browser, base64 it, paste here
IG_COOKIES_BASE64=

# Optional tuning
RETRY_GAP_MIN=5
PORT=3000
